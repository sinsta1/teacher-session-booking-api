{
  "name": "teacher-session-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for booking and completing teacher sessions",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/validation.test.ts",
    "test:integration": "node --import tsx --test tests/api.test.ts",
    "seed": "tsx scripts/seed.ts",
    "test:postman": "newman run postman/teacher-sessions.postman_collection.json --env-var baseUrl=http://localhost:3000"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.3",
    "newman": "^6.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
